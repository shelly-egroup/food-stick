rules_version = '2';

// 食在難選 — Firestore 權限規則
// 原則：只有 egroup.xx@gmail.com 的 Google 帳號能進來；進來後才看得到、改得到資料。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // egroup.xx@gmail.com，而且 Google 已驗證過信箱
    function isEgroup() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('egroup[.][^@]+@gmail[.]com');
    }
    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }
    function isMember() {
      return isEgroup() && exists(memberPath(request.auth.uid));
    }
    function isAdmin() {
      return isMember() && get(memberPath(request.auth.uid)).data.get('role', '') == 'admin';
    }
    function validText(s, min, max) {
      return s is string && s.size() >= min && s.size() <= max;
    }
    // 頭貼只能是 Google 帳號的大頭照（不提供上傳），或空白
    function validPhoto(s) {
      return validText(s, 0, 1000) && (s == '' || s.matches('https://lh[0-9]+[.]googleusercontent[.]com/.+'));
    }
    function validIdList(l) {
      return l is list && l.size() <= 500;
    }
    function exactKeys(keys) {
      return request.resource.data.keys().hasOnly(keys) && request.resource.data.keys().hasAll(keys);
    }

    match /members/{uid} {
      // 成員可以看大家；egroup 新同事在建立資料前也要能讀自己那一份（還不存在也沒關係）
      allow read: if isMember() || (isEgroup() && request.auth.uid == uid);
      // 第一次進來自動建立成員資料，只限 egroup 帳號
      allow create: if isEgroup() && request.auth.uid == uid
        && exactKeys(['name', 'photoURL', 'likes', 'blocks', 'joinedAt'])
        && validText(request.resource.data.name, 1, 40)
        && validPhoto(request.resource.data.photoURL)
        && request.resource.data.likes == []
        && request.resource.data.blocks == []
        && request.resource.data.joinedAt == request.time;
      // crews：自己存的揪團名單（進香團／冒險小隊），最多 8 個
      allow update: if isEgroup() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'likes', 'blocks', 'crews'])
        && validText(request.resource.data.name, 1, 40)
        && validPhoto(request.resource.data.photoURL)
        && validIdList(request.resource.data.likes)
        && validIdList(request.resource.data.blocks)
        && request.resource.data.get('crews', []) is list
        && request.resource.data.get('crews', []).size() <= 8;
      allow delete: if false;
    }

    function validRestaurant(d) {
      return validText(d.name, 1, 40)
        && d.category in ['rice', 'noodle', 'bento', 'snack', 'drink', 'dessert', 'world', 'light', 'brunch', 'other']
        && d.price in [1, 2, 3]
        && d.walk in [5, 10, 15, 20]
        && d.group is bool
        && validText(d.mapUrl, 0, 500)
        && (d.mapUrl == '' || d.mapUrl.matches('https://.+'));
    }

    // open：建立者可以決定要不要開放大家一起修改（沒有這個欄位的舊資料當作開放）
    function isOpen(d) {
      return d.get('open', true) == true;
    }

    match /restaurants/{rid} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['name', 'category', 'price', 'walk', 'group', 'mapUrl', 'open', 'createdBy', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'category', 'price', 'walk', 'group', 'mapUrl', 'createdBy', 'createdAt', 'updatedAt'])
        && validRestaurant(request.resource.data)
        && request.resource.data.get('open', true) is bool
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // 開放的店大家一起維護；沒開放的只有建立者能改。要不要開放也只有建立者能決定。建立者與建立時間不能改
      allow update: if isMember()
        && (isOpen(resource.data) || resource.data.createdBy == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'category', 'price', 'walk', 'group', 'mapUrl', 'open', 'updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['open'])
            || resource.data.createdBy == request.auth.uid)
        && request.resource.data.get('open', true) is bool
        && validRestaurant(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      // 只有建立者能拆
      allow delete: if isMember() && resource.data.createdBy == request.auth.uid;

      match /comments/{cid} {
        allow create: if isMember()
          && exactKeys(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && validText(request.resource.data.text, 1, 200)
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/restaurants/$(rid));
        // 留言者本人、管理員，或刪店時的店家建立者可以刪
        allow delete: if isMember() && (
          resource.data.uid == request.auth.uid
          || isAdmin()
          || get(/databases/$(database)/documents/restaurants/$(rid)).data.createdBy == request.auth.uid
        );
      }
    }

    // 人氣榜的「最新留言」用 collection group 查詢
    match /{path=**}/comments/{cid} {
      allow read: if isMember();
    }

    // ---------- 餐單：一餐一張（meals/{日期_餐別_發起人}），自己吃、揪團吃都是 ----------
    // 規則只擋「不該發生的寫入」；抽到哪一家、籤詩怎麼寫由畫面決定（同事之間互相信任）

    function mealSlotCode(d) {
      return d.slot.key == 'custom' ? 'c-' + d.slot.label : d.slot.key;
    }
    function validSlot(s) {
      return s is map && s.keys().hasOnly(['key', 'label']) && s.keys().hasAll(['key', 'label'])
        && s.key in ['breakfast', 'lunch', 'tea', 'dinner', 'supper', 'custom']
        && validText(s.label, 1, 8)
        && !s.label.matches('.*[/_.#\\[\\]].*');
    }
    function validFilters(f) {
      return f is map && f.keys().hasOnly(['categories', 'prices', 'walks', 'prefer'])
        && f.categories is list && f.categories.size() <= 20
        && f.prices is list && f.prices.size() <= 10
        && f.walks is list && f.walks.size() <= 10
        && f.prefer in ['favorites', 'explore'];
    }
    // 開單後三個小時結束（裝置時間可能有點誤差，前後放寬一小時）
    function validEnds(t) {
      return t is timestamp
        && t > request.time + duration.value(2, 'h')
        && t < request.time + duration.value(4, 'h');
    }
    // 抽到的一支：誰抽的一定是自己；時間是裝置的（陣列裡不能放伺服器時間），跟伺服器差十分鐘以內
    function validPick(p) {
      return p is map
        && p.keys().hasOnly(['rid', 'name', 'by', 'at', 'seed', 'variant', 'theme', 'lines', 'verdict'])
        && p.keys().hasAll(['rid', 'name', 'by', 'at', 'seed', 'variant', 'theme', 'lines', 'verdict'])
        && validText(p.rid, 1, 64)
        && validText(p.name, 1, 40)
        && p.by == request.auth.uid
        && p.at is timestamp
        && p.at > request.time - duration.value(10, 'm')
        && p.at < request.time + duration.value(10, 'm')
        && p.seed is int
        && validText(p.variant, 0, 16)
        && p.theme in ['temple', 'magic']
        && p.lines is list && (p.lines.size() == 0 || p.lines.size() == 4)
        && validText(p.verdict, 0, 60);
    }
    function validSkip(s, cands) {
      return s is map && s.keys().hasOnly(['rid', 'by', 'at', 'why']) && s.keys().hasAll(['rid', 'by', 'at'])
        && (!('why' in s) || s.why in ['crowded', 'closed', 'soldout', 'mood'])
        && s.rid in cands
        && s.by == request.auth.uid
        && s.at is timestamp
        && s.at > request.time - duration.value(10, 'm')
        && s.at < request.time + duration.value(10, 'm');
    }
    function mealLive(d) {
      return d.status != 'cancelled' && request.time < d.endsAt;
    }
    function mealGoing(d) {
      return request.auth.uid in d.going;
    }
    function onlyKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // 只往後加了一筆（前面的不逐一比對：規則每次最多算 1000 個運算式）
    function appendedOne(after, before) {
      return after.size() == before.size() + 1;
    }
    // 新的那一支：放到候選最後面（同一家又抽到就移到最後）
    function drewOne(after, before) {
      return appendedOne(after.picks, before.picks)
        && validPick(after.picks[before.picks.size()])
        && after.cands == before.cands.removeAll([after.picks[before.picks.size()].rid])
                           .concat([after.picks[before.picks.size()].rid]);
    }
    // 去不了：拿掉那一家；有補抽的話，補的那一支放到候選最後面
    function skippedOne(after, before) {
      return appendedOne(after.skips, before.skips)
        && validSkip(after.skips[before.skips.size()], before.cands)
        && ((after.picks.size() == before.picks.size()
             && after.cands == before.cands.removeAll([after.skips[before.skips.size()].rid]))
            || (appendedOne(after.picks, before.picks)
                && validPick(after.picks[before.picks.size()])
                && after.picks[before.picks.size()].rid != after.skips[before.skips.size()].rid
                && after.cands == before.cands.removeAll([after.skips[before.skips.size()].rid,
                                                          after.picks[before.picks.size()].rid])
                                              .concat([after.picks[before.picks.size()].rid])));
    }
    // 回覆要去（in）或不去（out）：要去的名單跟著改
    function answered(after, before) {
      return after.answers.diff(before.answers).affectedKeys().hasOnly([request.auth.uid])
        && ((after.answers[request.auth.uid] == 'in'
             && after.going == before.going.removeAll([request.auth.uid]).concat([request.auth.uid]))
            || (after.answers[request.auth.uid] == 'out'
                && after.going == before.going.removeAll([request.auth.uid])));
    }

    match /meals/{mid} {
      allow read: if isMember();

      // 開一餐：單號一定是「日期_餐別_自己」，同一個人同一天同一餐別只有一張；可以順便帶第一支
      allow create: if isMember()
        && exactKeys(['v', 'date', 'slot', 'host', 'party', 'answers', 'going', 'rerolls', 'rerollsLeft', 'filters', 'picks', 'cands', 'skips', 'decision', 'status', 'createdAt', 'updatedAt', 'endsAt'])
        && request.resource.data.v == 1
        && request.resource.data.host == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && validSlot(request.resource.data.slot)
        && mid == request.resource.data.date + '_' + mealSlotCode(request.resource.data) + '_' + request.auth.uid
        && request.resource.data.party is list
        && request.resource.data.party.size() >= 1
        && request.resource.data.party.size() <= 50
        && request.auth.uid in request.resource.data.party
        && request.resource.data.answers == {}
        && request.resource.data.going == [request.auth.uid]
        && request.resource.data.rerolls is int
        && request.resource.data.rerolls >= 0
        && request.resource.data.rerolls <= 5
        && request.resource.data.rerollsLeft == request.resource.data.rerolls
        && validFilters(request.resource.data.filters)
        && request.resource.data.skips == []
        && request.resource.data.decision == null
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validEnds(request.resource.data.endsAt)
        && ((request.resource.data.picks == [] && request.resource.data.cands == [])
            || (request.resource.data.picks.size() == 1
                && validPick(request.resource.data.picks[0])
                && request.resource.data.cands == [request.resource.data.picks[0].rid]));

      // 發起人：取消了、或時間到了還沒起駕，可以重新開張（抽過的、重抽次數都接續原本的）
      allow update: if onlyKeys(['party', 'answers', 'going', 'filters', 'status', 'decision', 'createdAt', 'updatedAt', 'endsAt'])
        && isMember()
        && resource.data.host == request.auth.uid
        && (resource.data.status == 'cancelled'
            || (resource.data.decision == null && request.time >= resource.data.endsAt))
        && request.resource.data.party is list
        && request.resource.data.party.size() >= 1
        && request.resource.data.party.size() <= 50
        && request.auth.uid in request.resource.data.party
        && request.resource.data.answers == {}
        && request.resource.data.going == [request.auth.uid]
        && validFilters(request.resource.data.filters)
        && request.resource.data.status == 'open'
        && request.resource.data.decision == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validEnds(request.resource.data.endsAt);

      // 要去的人：抽一支。第一支不扣，之後每支扣一次，扣到 0 就不能再抽；起駕後不能抽
      allow update: if onlyKeys(['picks', 'cands', 'rerollsLeft', 'updatedAt'])
        && isMember()
        && mealGoing(resource.data)
        && mealLive(resource.data)
        && resource.data.status == 'open'
        && drewOne(request.resource.data, resource.data)
        && ((resource.data.picks.size() == 0
             && request.resource.data.rerollsLeft == resource.data.rerollsLeft)
            || (resource.data.picks.size() > 0
                && resource.data.rerollsLeft >= 1
                && request.resource.data.rerollsLeft == resource.data.rerollsLeft - 1))
        && request.resource.data.updatedAt == request.time;

      // 要去的人：起駕（從候選選一家，就是定案）；起駕後、這餐結束前也可以改去候選裡的別張
      allow update: if onlyKeys(['decision', 'status', 'updatedAt'])
        && isMember()
        && mealGoing(resource.data)
        && mealLive(resource.data)
        && (resource.data.status == 'open'
          || (resource.data.status == 'decided'
            && request.resource.data.decision.rid != resource.data.decision.rid))
        && request.resource.data.status == 'decided'
        && request.resource.data.decision is map
        && request.resource.data.decision.keys().hasOnly(['rid', 'by', 'at'])
        && request.resource.data.decision.keys().hasAll(['rid', 'by', 'at'])
        && request.resource.data.decision.rid in resource.data.cands
        && request.resource.data.decision.by == request.auth.uid
        && request.resource.data.decision.at == request.time
        && request.resource.data.updatedAt == request.time;

      // 要去的人：這家去不了（起駕後也可以）。重抽次數回到原本的數字，回到還在抽的階段
      allow update: if onlyKeys(['skips', 'picks', 'cands', 'rerollsLeft', 'decision', 'status', 'updatedAt'])
        && isMember()
        && mealGoing(resource.data)
        && mealLive(resource.data)
        && skippedOne(request.resource.data, resource.data)
        && request.resource.data.rerollsLeft == resource.data.rerolls
        && request.resource.data.decision == null
        && request.resource.data.status == 'open'
        && request.resource.data.updatedAt == request.time;

      // 被揪的人：回覆要去或不去，這一餐結束前都可以改
      allow update: if onlyKeys(['answers', 'going', 'updatedAt'])
        && isMember()
        && request.auth.uid in resource.data.party
        && request.auth.uid != resource.data.host
        && mealLive(resource.data)
        && answered(request.resource.data, resource.data)
        && request.resource.data.updatedAt == request.time;

      // 發起人：取消
      allow update: if onlyKeys(['status', 'updatedAt'])
        && isMember()
        && resource.data.host == request.auth.uid
        && resource.data.status in ['open', 'decided']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt == request.time;

      // 發起人：再揪幾個人（只能加、不能踢）
      allow update: if onlyKeys(['party', 'updatedAt'])
        && isMember()
        && resource.data.host == request.auth.uid
        && mealLive(resource.data)
        && request.resource.data.party.hasAll(resource.data.party)
        && request.resource.data.party.size() <= 50
        && request.resource.data.updatedAt == request.time;

      // 發起人：改篩選（起駕前）
      allow update: if onlyKeys(['filters', 'updatedAt'])
        && isMember()
        && resource.data.host == request.auth.uid
        && mealLive(resource.data)
        && resource.data.status == 'open'
        && validFilters(request.resource.data.filters)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}
