# 正式 Firebase 專案的設定，複製成 .env.local 後填入（.env.local 不會上傳到 GitHub）
# - npm run dev       ：本機模擬器與示範資料（不會碰到正式資料）
# - npm run dev:live  ：開發時直接連正式專案（http://localhost:3000）
# - npm run build     ：正式網站，一律連正式專案
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# AI 寫籤詩（只在伺服器端讀，不會進到瀏覽器）：Groq 的 key，多把用逗號分隔；沒填就用網站原本的籤詩
GROQ_KEYS=
# 想換模型再填（逗號分隔，前面的先用），預設 qwen/qwen3.8-27b,openai/gpt-oss-120b
# GROQ_MODELS=
