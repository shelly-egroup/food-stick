{
  "name": "lunchstick",
  "private": true,
  "version": "0.1.0",
  "description": "食在難選：公司午餐求籤所",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5173 -H 127.0.0.1",
    "dev:test": "node scripts/dev-test.mjs",
    "dev:live": "node scripts/dev-live.mjs",
    "build": "next build",
    "start": "next start -p 5173 -H 127.0.0.1",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "emulators": "firebase emulators:start --project demo-lunchstick --only auth,firestore",
    "seed": "node scripts/seed.mjs",
    "test": "tsx --test src/lib/draw.test.ts src/lib/format.test.ts src/lib/meal.test.ts src/lib/types.test.ts src/themes/reading.test.ts src/themes/temple/reading.test.ts src/themes/magic/reading.test.ts src/themes/magic/moon.test.ts src/server/verse.test.ts src/server/egg.test.ts",
    "test:rules": "firebase emulators:exec --project demo-lunchstick --only firestore \"tsx --test tests/rules.test.ts\"",
    "shots": "node scripts/shots.mjs",
    "deploy:firestore": "firebase deploy --only firestore",
    "deploy:firestore:test": "firebase deploy --only firestore --project test",
    "copy:prod-to-test": "node scripts/copy-prod-to-test.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource/cactus-classical-serif": "^5.3.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/lxgw-wenkai-tc": "5.3.1",
    "@fontsource/noto-sans-tc": "5.3.1",
    "@fontsource/noto-serif-tc": "5.3.1",
    "firebase": "12.19.0",
    "gsap": "3.15.0",
    "jose": "^6.2.12",
    "next": "^16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.8",
    "firebase-admin": "13.10.0",
    "firebase-tools": "13.35.1",
    "playwright": "1.64.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "universal-analytics": "0.5.3"
  }
}
